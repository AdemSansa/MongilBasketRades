<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: permits plain HTTP to the local dev backend. Android blocks
  cleartext traffic by default since API 28. Never applied to release
  builds — this file lives under src/debug/, not src/main/.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.100.105</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
